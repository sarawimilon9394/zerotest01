# ==============================================================================
# BERMUDA PORTAL - ZEROPS CLOUD GATEWAY ENVIRONMENT TEMPLATE
# Platform: Zerops.io (Prague prg1 / US-East) + Cloudflare Dedicated IPv6 Edge
# Usage: Paste into Zerops Service -> Environment Variables -> Secret Variables
# ==============================================================================

# [Recommended for Edge Tuning & Multi-Port] Cloudflare API Token (Zone/DNS/Ruleset Edit)
# Note: In Cloudflare Token creation, set Zone Resources -> Include -> Specific zone -> your domain
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Recommended for Auto-Provisioning] Zerops Personal Access Token
# Direct Link: https://app.zerops.io/settings/token-management
ZEROPS_API_TOKEN=

# [Optional] Explicit Zerops Project ID & Service Stack ID (Auto-discovered via API if empty)
ZEROPS_PROJECT_ID=
ZEROPS_SERVICE_ID=

# [Optional] Custom Domain routed through Cloudflare Edge (e.g. portal.yourdomain.dpdns.org)
CUSTOM_DOMAIN=

# [Optional] Free Zerops Subdomain (e.g. portal-1ef2-8080.prg1.zerops.app)
# Auto-enabled & discovered via ZEROPS_API_TOKEN or first HTTP request if left empty
ZEROPS_SUBDOMAIN=

# [Optional] Project Free Dedicated IPv6 Address (e.g. 2a02:xxxx:xxxx::1)
# Auto-discovered via ZEROPS_API_TOKEN for Cloudflare AAAA record binding if left empty
ZEROPS_PROJECT_IPV6=

# [Recommended] Master Secret Seed for Deterministic Key Derivation (e.g. bmk-...)
# Auto-generated & persisted via local zsc / Zerops API if left empty
BERMUDA_MASTER_KEY=

# [Optional] Deployment Region (prg1, eu-central, de-fra1, fi-hel1, europe-west4, us-east4)
BERMUDA_REGION=prg1
